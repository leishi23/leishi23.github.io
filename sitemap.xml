---
layout: null
title : Sitemap
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for post in site.posts %}
    <url>
        <loc>{{ site.url }}{{ post.url | prepend: site.baseurl | xml_escape }}</loc>
    </url>
{% endfor %}
{% for page in site.pages %}
    {% unless page.url contains '.xml' or page.url contains '.json' or page.url contains '.txt' or page.url contains '404' %}
    <url>
        <loc>{{ site.url }}{{ page.url | prepend: site.baseurl | xml_escape }}</loc>
    </url>
    {% endunless %}
{% endfor %}
</urlset>
