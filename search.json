---
layout: null
---
{
  "code": 0,
  "data": [
    {% for post in site.posts %}{% capture t %}{{ post.title }} - {{ post.date | date: "%Y-%m-%d" }}{% endcapture %}{
      "title": {{ t | jsonify }},
      "url": {{ post.url | prepend: site.baseurl | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
